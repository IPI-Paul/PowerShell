<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="Select CSV"
        Height="300"
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView Name="CsvList" Grid.Row="0" Margin="0, 0, 0, 2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="50" DisplayMemberBinding="{Binding Number}" />
                    <GridViewColumn Header="CSV Path" Width="500" DisplayMemberBinding="{Binding Path}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel  Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="OkButton" Width="80" Margin="2">OK</Button>
            <Button Name="CancelButton" Width="80" Margin="2">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>